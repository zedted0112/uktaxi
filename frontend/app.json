{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/home-carousel/Slide_2.jpg",
    "scheme": "com.ukparivahan.app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ukparivahan.app"
    },
    "android": {
      "package": "com.ukparivahan.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/home-carousel/Slide_2.jpg",
        "backgroundColor": "#000"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/home-carousel/Slide_2.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/home-carousel/Slide_2.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000"
        }
      ],
      "@react-native-community/datetimepicker",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cae667c0-4293-41d4-82a2-8025bb92420f"
      }
    },
    "owner": "himalayancoder"
  }
}
