# Copy to .env (gitignored). EXPO_PUBLIC_* are embedded at bundle time — restart Metro after edits.

# Cloud API (used when EXPO_PUBLIC_DEMO_MODE is not true).
EXPO_PUBLIC_BACKEND_URL=https://your-api.example.com

# true = local backend only (Metro LAN / localhost / emulator); demo OTP UI on.
# false or unset = cloud only (this URL); no local fallbacks.
EXPO_PUBLIC_DEMO_MODE=false

# Optional: show demo OTP UI while still using cloud API (Expo Go hitting prod-like API).
EXPO_PUBLIC_FORCE_DEMO_OTP=false

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
