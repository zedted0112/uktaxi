# Copy to .env (gitignored). EXPO_PUBLIC_* are embedded at bundle time — restart Metro after edits.

# Cloud API (when EXPO_PUBLIC_DEMO_MODE is not true). For LAN dev use http://YOUR_LAN_IP:8000
EXPO_PUBLIC_BACKEND_URL=https://your-api.example.com

# true = local backend only (Metro LAN / localhost / emulator); demo OTP UI on.
# false or unset = cloud only (this URL); no local fallbacks.
EXPO_PUBLIC_DEMO_MODE=false

# Optional: show demo quick-sign-in + OTP while using cloud API, or when GET /api/ is unreachable.
# Combines EXPO_PUBLIC_SHOW_DEMO_AUTH and EXPO_PUBLIC_FORCE_DEMO_OTP (see frontend/src/api.ts).
EXPO_PUBLIC_SHOW_DEMO_AUTH=false
EXPO_PUBLIC_FORCE_DEMO_OTP=false

# true = request OS notification permission and register Expo push token to backend.
# Keep false in demo-only/dev flows where push is not being validated.
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=false

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
