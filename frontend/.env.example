# Local dev (LAN) or private EC2 over HTTP, e.g. http://YOUR_ELASTIC_IP/api (no trailing slash issues — api.ts normalizes).
EXPO_PUBLIC_BACKEND_URL=http://192.168.1.73:8000

# Optional: true => show demo quick-sign-in + OTP UI even if GET /api/ is unreachable (Expo Go / flaky LAN).
# Normally leave false and rely on backend ENABLE_DEMO_MODE=true (GET /api/ returns demo_mode: true).
EXPO_PUBLIC_FORCE_DEMO_OTP=false

# Google Sign-In (required when backend demo mode is false)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

