# Copy to .env (gitignored). EXPO_PUBLIC_* are embedded at bundle time — restart Metro after edits.

EXPO_PUBLIC_BACKEND_URL=http://192.168.1.73:8000

# true = dev with Expo Go: local / Metro bases first, then EXPO_PUBLIC_BACKEND_URL as fallback.
# false = production-style: EXPO_PUBLIC_BACKEND_URL first, then local fallbacks.
EXPO_PUBLIC_ENV_MODE_DEV=false

# true = show demo chips / OTP hints even if GET /api/ says demo_mode false (use with Expo Go + local).
EXPO_PUBLIC_FORCE_DEMO_OTP=false

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
