# Copy to backend/.env (gitignored) and fill in real values.
# MongoDB connection string (Atlas or local).
MONGO_URL=mongodb://localhost:27017
# Dev database for daily development/testing.
DB_NAME=UKTaxi_Dev
# Production should use:
# DB_NAME=UKTaxi_PROD

# Comma-separated origins, or * for local dev.
CORS_ORIGINS=*

# true = startup may seed demo users/rides/requests and mount GET /api/demo/accounts
# false = no destructive seed, no demo routes (use for production / real data).
ENABLE_DEMO_MODE=true

# Optional: verify Google token audience exactly against this client ID.
GOOGLE_WEB_CLIENT_ID=

# API auth token settings (change secret in production).
JWT_SECRET_KEY=replace-with-strong-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=168

# Optional: NDJSON debug log file for local troubleshooting (omit in production).
# DEBUG_LOG_PATH=/tmp/uktaxi-debug.log
