# Copy to backend/.env (gitignored) and fill in real values.
# MongoDB connection string (Atlas or local).
MONGO_URL=mongodb://localhost:27017
DB_NAME=uktaxi

# Comma-separated origins, or * for local dev.
CORS_ORIGINS=*

# true = startup may seed demo users/rides/requests and mount GET /api/demo/accounts
# false = no destructive seed, no demo routes (use for production / real data).
ENABLE_DEMO_MODE=true
